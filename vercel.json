{
  "framework": "vite",
  "buildCommand": "npx pnpm run build",
  "outputDirectory": "artifacts/qa-machine-board/dist/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
